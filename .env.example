# Copy to .env.local (and set the same vars in Vercel → Project → Environment Variables)

# Production URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://queenscosmetics.co

# Google Analytics 4 Measurement ID (create the property in analytics.google.com)
NEXT_PUBLIC_GA_ID=

# Google Search Console meta verification token (optional — DNS verification is preferred)
NEXT_PUBLIC_GSC_VERIFICATION=

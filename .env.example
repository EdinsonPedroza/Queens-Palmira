# Copy to .env.local for local builds, and set the same variables in Cloudflare → Workers & Pages → the project → Settings → Variables (build variables).
#
# ⚠ Everything named NEXT_PUBLIC_* is written INTO THE PUBLIC JAVASCRIPT AND HTML of the site: anyone can read it. Only public values go here (a site URL,
# an analytics id). NEVER put a password, an API key or a token in a NEXT_PUBLIC_ variable, and never commit .env.local (it is in .gitignore).
# This site has no backend and needs no secret at all.

# Production URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://queenscosmeticscol.com

# Google Analytics 4 Measurement ID (public by design). Leave it empty to keep Analytics off; when set, the build also allows Google's hosts in the CSP.
NEXT_PUBLIC_GA_ID=

# Google Search Console meta verification token (optional — DNS verification is preferred)
NEXT_PUBLIC_GSC_VERIFICATION=
